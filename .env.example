# Token da brapi.dev (opcional na POC).
# Sem chave, o plano gratuito atende apenas PETR4, VALE3, MGLU3 e ITUB4 —
# cotação, histórico e comparação. Com chave, todos os tickers da B3.
BRAPI_API_KEY=

# Watchlist do dashboard (opcional; separada por vírgula).
# Padrão: PETR4,VALE3,MGLU3,ITUB4,MXRF11,HGLG11
# MXRF11/HGLG11 ficam na lista de propósito para mostrar o estado "sem chave".
BRAPI_WATCHLIST=

# Rate limit do BFF por IP (requisições por minuto; padrão 120).
BFF_RATE_LIMIT_MAX=

# Sobrescrita das APIs upstream (usada pelo E2E com a fixture local;
# deixe vazio para usar as URLs reais).
BRAPI_BASE_URL=
BCB_SGS_BASE_URL=
